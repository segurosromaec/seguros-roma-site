---
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";
import { whatsappLink } from "../utils/format";

const wa = whatsappLink(site.whatsapp_numero, site.whatsapp_mensaje);
---

<Layout title="Contacto" description="Contáctanos para una cotización.">
	<div class="container">
		<h1>Contacto</h1>
		{wa && <p><a class="btn" href={wa} rel="noopener">Escríbenos por WhatsApp</a></p>}
		{site.telefono_display && <p>Teléfono: <a href={`tel:${site.telefono_display.replace(/\s/g, "")}`}>{site.telefono_display}</a></p>}
		{site.direccion && <p>{site.direccion}</p>}
		{site.horario && <p>Horario: {site.horario}</p>}
		{!wa && !site.telefono_display && <p>Datos de contacto por definir.</p>}
	</div>
</Layout>
