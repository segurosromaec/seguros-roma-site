---
import { ICONOS, type NombreIcono } from "./icons";

interface Props {
	name: NombreIcono;
	size?: number;
}

const { name, size = 24 } = Astro.props;
---

<svg
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
	set:html={ICONOS[name]}
/>
