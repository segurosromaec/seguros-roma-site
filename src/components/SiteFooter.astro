---
import { getImage } from "astro:assets";
import logoHorizontal from "../assets/brand/logo-horizontal.png";
import site from "../data/site.json";
import Icon from "./Icon.astro";

const logo = await getImage({ src: logoHorizontal, width: 480, format: "webp" });
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-inner">
		<img src={logo.src} alt={`${site.nombre}: ${site.slogan}`} width={logo.options.width} height={logo.options.height} loading="lazy" />
		<ul class="social" aria-label="Redes sociales">
			<li><a href={site.instagram_url} rel="noopener noreferrer" target="_blank" aria-label={`Instagram ${site.usuario_redes}`}><Icon name="instagram" /></a></li>
			<li><a href={site.facebook_url} rel="noopener noreferrer" target="_blank" aria-label={`Facebook ${site.usuario_redes}`}><Icon name="facebook" /></a></li>
		</ul>
		<p class="copy">© {year} {site.nombre}. Todos los derechos reservados.</p>
	</div>
</footer>

<style>
	.site-footer { background: var(--color-marfil); border-top: 3px solid var(--color-dorado); }
	.footer-inner {
		display: flex; flex-direction: column; align-items: center; gap: var(--space-4);
		max-width: var(--container); margin: 0 auto; padding: var(--space-8) var(--space-4);
		text-align: center;
	}
	img { height: 72px; width: auto; }
	.social { display: flex; gap: var(--space-3); list-style: none; margin: 0; padding: 0; }
	.social a {
		display: grid; place-items: center; width: var(--tap-min); height: var(--tap-min);
		color: var(--color-primary); border: 2px solid var(--color-primary); border-radius: 50%;
	}
	.social a:hover { background: var(--color-primary); color: var(--color-on-primary); }
	.copy { margin: 0; font-size: var(--text-sm); }
</style>
